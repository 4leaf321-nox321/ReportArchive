      "content": {
        "h1_deploy": { "text": "배포 구조 · 실행 방법" },
        "rt_deploy_intro": { "markdown": "운영 환경은 **apptainer SIF 단일 이미지** 안에 백엔드(FastAPI + venv) 와 프론트엔드 빌드 산출물(`frontend/dist`) 을 함께 박아 둔다. 호스트에는 **apptainer 1.x + PostgreSQL** 만 깔려 있으면 된다. Node.js / npm 은 운영 서버에 불필요 (빌드 타임 의존성)." },
        "h2_endpoints": { "text": "포트 · 엔드포인트" },
        "kv_endpoints": {
          "items": [
            { "key": "backend_port",  "label": "백엔드 (uvicorn)",   "type": "text" },
            { "key": "frontend_port", "label": "프론트엔드 (개발)",  "type": "text" },
            { "key": "db_port",       "label": "PostgreSQL",          "type": "text" },
            { "key": "api_root",      "label": "API 루트",           "type": "text" },
            { "key": "health",        "label": "헬스 체크",          "type": "text" },
            { "key": "docs",          "label": "API 문서 (Swagger)", "type": "text" },
            { "key": "spa_fallback",  "label": "SPA 폴백",            "type": "text" },
            { "key": "uploads_dir",   "label": "업로드 (bind mount)", "type": "text" }
          ],
          "backend_port":  "3000",
          "frontend_port": "3001 (Vite — /api/* 는 :3000 으로 프록시)",
          "db_port":       "5433 (운영, 비표준) · 5432 (개발 기본)",
          "api_root":      "/api",
          "health":        "/api/health",
          "docs":          "/api/docs",
          "spa_fallback":  "결합 배포 시 /api/* 외 모든 경로 → index.html",
          "uploads_dir":   "uploads/ · logs/ · .env (ro) 가 컨테이너에 bind"
        },
        "h2_modes": { "text": "배포 시나리오 비교" },
