[Unit]
Description=Report Archive Backend (FastAPI in Apptainer)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=@@USER@@
Group=@@USER@@
WorkingDirectory=@@INSTALL_DIR@@

# Bind-mount layout:
#   .env           → read-only into the container's backend root
#   uploads/, logs/→ writable, host-side persistence
ExecStart=/usr/bin/apptainer run \
    --bind @@INSTALL_DIR@@/.env:/opt/app/backend/.env:ro \
    --bind @@INSTALL_DIR@@/uploads:/data/uploads \
    --bind @@INSTALL_DIR@@/logs:/data/logs \
    @@INSTALL_DIR@@/app.sif

Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# Light hardening — Apptainer is already rootless / namespace-isolated.
# ProtectHome is OFF because the install dir lives under /home/<operator>.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
