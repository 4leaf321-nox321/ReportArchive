[Unit]
Description=Report Archive Background Worker (Job Queue in Apptainer)
After=network-online.target postgresql.service reportarchive.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=@@USER@@
Group=@@USER@@
WorkingDirectory=@@INSTALL_DIR@@

# 웹(reportarchive.service)과 동일한 SIF·venv·.env·DB 를 재사용하되,
# uvicorn(run.py) 대신 작업 큐 워커(worker.py)를 띄운다. apptainer exec 는
# %runscript 를 건너뛰고 지정한 명령을 컨테이너 안에서 실행한다.
# python 이 스크립트 디렉터리(/opt/app/backend)를 sys.path 에 넣으므로
# `import app …` 이 cwd 와 무관하게 동작한다.
ExecStart=/usr/bin/apptainer exec \
    --bind @@INSTALL_DIR@@/.env:/opt/app/backend/.env:ro \
    --bind @@INSTALL_DIR@@/uploads:/data/uploads \
    --bind @@INSTALL_DIR@@/logs:/data/logs \
    @@INSTALL_DIR@@/app.sif /opt/app/venv/bin/python /opt/app/backend/worker.py

Restart=on-failure
RestartSec=10
# graceful shutdown: 진행 중인 작업을 마칠 여유. worker.py 가 SIGTERM 에
# stop 이벤트를 걸고 in-flight 를 드레인한다.
TimeoutStopSec=60

# Light hardening — 백엔드 유닛과 동일 기조.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
