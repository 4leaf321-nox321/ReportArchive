# Application
APP_ENV=development
APP_NAME=ReportAutomation
APP_HOST=0.0.0.0
APP_PORT=3000

# Security
SECRET_KEY=change-this-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Database (PostgreSQL via psycopg3)
DATABASE_URL=postgresql+psycopg://postgres:32167@localhost:5432/report_automation
TEST_DATABASE_URL=postgresql+psycopg://postgres:32167@localhost:5432/report_automation_test

# CORS - allow comma-separated list of origins
# In production, list only your real frontend host(s).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend dist serving (combined-deployment mode)
# Leave empty to disable. Path can be absolute, or relative to backend root.
# Example: ../frontend/dist
SERVE_FRONTEND_DIST=

# Uvicorn (production)
UVICORN_WORKERS=4

# ── 이메일 발송 (메일러 — SMTP 클라이언트) ──────────────────────────────
# 플랫폼은 메일 서버가 아니라 기존 SMTP 릴레이에 접속해 나가는 메일만 보낸다.
# EMAIL_BACKEND: smtp(운영 실제발송) | console(개발 로그만) | mock(테스트).
# 기본 console → 아래를 smtp 로 바꾸고 SMTP_HOST 를 채우기 전까지 실제 발송 없음.
EMAIL_BACKEND=console
# 사내 SMTP 릴레이 주소(인프라/IT 팀에서 받음). 비우면 smtp 라도 발송 불가.
SMTP_HOST=
SMTP_PORT=587
# TLS: none(평문 내부릴레이) | starttls(587) | ssl(465)
SMTP_TLS_MODE=starttls
# 인증 — 무인증 내부 릴레이면 비워둔다(둘 다 있어야 로그인 시도)
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_S=20
# 발신/회신 주소(운영 정책의 no-reply 주소로 지정)
EMAIL_FROM=ReportArchive <no-reply@reportarchive.local>
EMAIL_REPLY_TO=
# 메일 본문 링크(비밀번호 재설정 등) 기준 URL. 비우면 CORS_ORIGINS 첫 항목 사용.
APP_BASE_URL=
# 셀프 비밀번호 재설정(이메일 링크). false 면 '비밀번호 찾기'는 메일이 나갈 수
# 있는 환경이어도 관리자 중개 큐로만 간다. SMTP 를 알림·다이제스트 용도로 켤 때
# 셀프 재설정까지 딸려 켜지는 걸 막는다. 켜려면 APP_BASE_URL 도 함께 채울 것.
PASSWORD_SELF_RESET_ENABLED=false
