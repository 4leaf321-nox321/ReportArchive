# Copy to .env / .env.development / .env.production as needed.
#
# Frontend treats the backend as an external service. Two knobs control
# where API calls are sent:
#
#   VITE_API_BASE_URL       Full URL prefix used by the API client at runtime.
#                           Leave empty to use relative URLs (/api/...) — best
#                           for combined deployment (backend serves the build)
#                           and for dev (Vite proxy handles it).
#                           Set to e.g. https://api.example.com when the
#                           frontend and backend are on different hosts.
#
#   VITE_API_PROXY_TARGET   Dev-only. Vite proxies /api/* to this URL.
#                           Defaults to http://localhost:3000.

VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_DEV_PORT=3001
