          { "category": "진행",   "widget": "milestone",     "purpose": "타임라인 마커 (pending / done / delayed)" },
          { "category": "진행",   "widget": "flowchart",     "purpose": "순차 플로우 (가로 / 세로)" },
          { "category": "진행",   "widget": "progress_bar",  "purpose": "여러 작업 진척도 한 번에 (자동 색상 매핑)" },
          { "category": "미디어", "widget": "image",         "purpose": "이미지 1장 또는 갤러리" },
          { "category": "미디어", "widget": "attachment",    "purpose": "PDF / 스프레드시트 등 다운로드 카드" },
          { "category": "미디어", "widget": "video",         "purpose": "mp4 / webm 동영상 재생" },
          { "category": "미디어", "widget": "cad_3d",        "purpose": "3D CAD 모델 뷰어 (GLB/GLTF/STL/OBJ)" },
          { "category": "미디어", "widget": "html_embed",    "purpose": "업로드 HTML 파일 sandbox iframe 렌더" }
        ] },
        "h2_widget_tips": { "text": "혼동하기 쉬운 위젯 쌍" },
        "bl_widget_tips": { "items": [
          "box vs density — box 는 rows: [{group, value}] (long-form 관측값), density 는 groups: [{name, values: []}] (raw array). 키 절대 섞지 말 것.",
          "chart vs scatter — chart 는 x축이 카테고리(text/date), scatter 는 x·y 모두 number. x 가 수치면 scatter.",
          "tree / mind_map vs flowchart — 앞의 둘은 rows: [{label, parent}] (계층), flowchart 는 items: [{label}] (순차, parent 없음).",
          "table vs comparison vs raci_matrix — table 행 키 = columns.key, comparison 행 values 키 = cases.key, raci_matrix 행 assignments 값 = R/A/C/I.",
          "treemap vs packing — content 모양 완전 동일, 시각만 사각 / 원형 차이.",
          "key_value vs table — key_value 는 보고서마다 항목 다른 자유 카드, table 은 모든 보고서가 공유하는 정형 표."
        ] }
      },
