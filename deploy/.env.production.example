# Report Archive — Production .env template
#
# Copy this file to `.env` on the production server and fill in real values.
#
# On first install, `deploy.sh install` auto-generates this file with random
# secrets + DB password (replacing the REPLACE_WITH_… / CHANGE_ME placeholders).
# Edit the rest (CORS_ORIGINS, ports, etc.) before going live.
#
# Generate secrets manually with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Application ---
APP_ENV=production
APP_NAME=ReportAutomation
APP_HOST=0.0.0.0
APP_PORT=3000
UVICORN_WORKERS=4

# --- Security (MUST replace these!) ---
SECRET_KEY=REPLACE_WITH_RANDOM_48_CHAR_SECRET
JWT_SECRET_KEY=REPLACE_WITH_DIFFERENT_RANDOM_48_CHAR_SECRET
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Database ---
# Host=localhost works because Apptainer uses host networking (no port mapping).
# The user/password/db must match what you created in README §3.
DATABASE_URL=postgresql+psycopg://reportarchive:CHANGE_ME@localhost:5433/report_automation

# --- CORS ---
# List the real frontend host(s). For combined deploy (frontend served by
# backend), leave only the backend's own host or empty.
CORS_ORIGINS=https://reportarchive.example.com

# --- Frontend serving (combined deployment — same host, no nginx) ---
# Absolute path inside the container — do NOT change unless you also change
# the .def file. Leave empty for separate-host deployments.
SERVE_FRONTEND_DIST=/opt/app/frontend/dist

# --- File uploads ---
# /data is the in-container path; systemd bind-mounts it from
# <INSTALL_DIR>/uploads on the host (see reportarchive.service.template).
# Don't change unless you also adjust the unit file's --bind options.
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_BYTES=26214400
