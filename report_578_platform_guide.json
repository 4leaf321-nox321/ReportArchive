    {
      "template_id": "1da9d132-fe8d-4139-9176-4184be86c011",
      "template_version": 2,
      "name": "4. 권한 모델",
      "extra_blocks": [
        { "id": "h1_perm", "type": "heading", "props": { "level": 1, "default_text": "권한 · 역할 모델" } },
        { "id": "rt_perm_intro", "type": "rich_text", "props": {} },
        { "id": "h2_can_edit", "type": "heading", "props": { "level": 2, "default_text": "can_edit() 판정 순서" } },
        { "id": "fc_can_edit", "type": "flowchart", "props": { "label": "편집 권한 판정", "orientation": "vertical" } },
        { "id": "h2_raci", "type": "heading", "props": { "level": 2, "default_text": "역할 × 작업 매트릭스" } },
        { "id": "raci_perm", "type": "raci_matrix", "props": { "label": "ReportArchive 표준 RACI" } },
        { "id": "h2_mount_policy", "type": "heading", "props": { "level": 2, "default_text": "Mount 별 편집 정책 (per-mount)" } },
        { "id": "bl_mount_policy", "type": "bulleted_list", "props": { "label": "ReportMount.edit_policy" } },
        { "id": "h2_lock", "type": "heading", "props": { "level": 2, "default_text": "작성자 수정 잠금 (Hard Lock)" } },
        { "id": "rt_lock", "type": "rich_text", "props": {} }
      ],
      "content": {
        "h1_perm": { "text": "권한 · 역할 모델" },
        "rt_perm_intro": { "markdown": "**소유권(owner)** 과 **편집권(edit right)** 은 별개. 보직장이 손봐도 소유권은 작성자에게 유지된다. 편집권은 단일 진입점 함수 `can_edit(db, user, report) -> EditDecision` 으로만 판정한다 (PATCH /reports/{id}, 향후 composite inline 편집 등 모든 편집 시점에서 호출)." },
        "h2_can_edit": { "text": "can_edit() 판정 순서" },
        "fc_can_edit": { "items": [
          { "label": "0. 시스템 관리자 우회",        "description": "is_system_admin → 항상 허용 (lock 도 무시)" },
          { "label": "1. Hard lock 체크",             "description": "author_lock_enabled & user ≠ owner → 거부 (sys admin 제외)" },
          { "label": "2. 작성자(owner) 본인",         "description": "owner_user_id 일치 → 허용 (role=owner)" },
          { "label": "3. 명시 추가 편집자",            "description": "is_listed_editor → 허용 (role=editor)" },
          { "label": "4. Mount 별 walk",               "description": "각 mount.edit_policy 에 따라: lead(ancestor) / coauthor(ancestor 포함 멤버)" },
          { "label": "5. 모두 실패 → 거부",            "description": "role=none, allowed=false" }
        ] },
        "h2_raci": { "text": "역할 × 작업 매트릭스" },
        "raci_perm": {
          "roles": [
            { "key": "owner",    "label": "작성자",       "group": "보고서 권한" },
            { "key": "editor",   "label": "추가 편집자",  "group": "보고서 권한" },
            { "key": "lead",     "label": "보직장",       "group": "조직 권한" },
            { "key": "member",   "label": "부서 멤버",    "group": "조직 권한" },
            { "key": "sysadmin", "label": "시스템 관리자","group": "운영" }
          ],
          "rows": [
            { "label": "보고서 본문 작성 / 저장",       "assignments": { "owner": "R/A", "editor": "R",   "lead": "R",   "member": "I",   "sysadmin": "R" } },
            { "label": "조직 게시판에 게시 (Mount)",    "assignments": { "owner": "R/A", "editor": "C",   "lead": "C",   "member": "I",   "sysadmin": "R" } },
            { "label": "코멘트 작성 / 의견 제시",        "assignments": { "owner": "A",   "editor": "R",   "lead": "R",   "member": "R",   "sysadmin": "R" } },
            { "label": "작성자 수정 잠금 ON/OFF",        "assignments": { "owner": "R/A", "editor": "I",   "lead": "I",   "member": "I",   "sysadmin": "I" } },
            { "label": "잠금 강제 해제 (작성자 부재)",   "assignments": { "owner": "C",   "editor": "I",   "lead": "I",   "member": "I",   "sysadmin": "R/A" } },
            { "label": "종합보고 작성 / item 묶기",      "assignments": { "owner": "C",   "editor": "I",   "lead": "R/A", "member": "I",   "sysadmin": "R" } },
            { "label": "워크스페이스 멤버 관리",          "assignments": { "owner": "I",   "editor": "I",   "lead": "R/A", "member": "I",   "sysadmin": "R" } },
            { "label": "템플릿 / 위젯 / 시스템 설정",    "assignments": { "owner": "I",   "editor": "I",   "lead": "C",   "member": "I",   "sysadmin": "R/A" } }
          ]
        },
        "h2_mount_policy": { "text": "Mount 별 편집 정책 (per-mount)" },
        "bl_mount_policy": { "items": [
          "default — 작성자 + 보직장 편집 (가장 일반적, 한국 조직 문화 기본값).",
          "owner_only — 작성자만 편집 (보직장도 차단). 외부 제출 직전이나 인사평가 보고서.",
          "coauthor — 게시판 멤버 전원 편집 가능 (ancestor 포함). 공동 작성 프로젝트.",
          "같은 보고서라도 mount 된 게시판마다 다르게 설정 가능 — \"팀1엔 공동 작성, 본부엔 본인만\" 같은 케이스 지원.",
          "게시 다이얼로그에서 게시판별 dropdown 으로 선택."
        ] },
        "h2_lock": { "text": "작성자 수정 잠금 (Hard Lock)" },
        "rt_lock": { "markdown": "민감한 보고서(외부 제출, 인사평가)용 최상위 veto.\n\n- 락 ON → **작성자 외 모든 편집 차단** (보직장 · 추가편집자 · coauthor 모두).\n- 해제는 **작성자 본인**. 부재 시 **시스템 관리자만 강제 해제** 가능 (액션 로그 영구 기록).\n- 락 ON 시 게시된 모든 게시판의 lead 에게 알림 발송 (보직장이 황당하지 않도록).\n- 헤더 표시 예: *\"박과장이 수정 잠금 (사유: 외부 제출 준비) — 작성자 외 편집 불가\"*\n- 모델: `Report.author_lock_enabled`, `author_lock_reason`, `author_lock_set_at`." }
      },
      "layout_overrides": null,
      "props_overrides": null,
      "blocks_order": [],
