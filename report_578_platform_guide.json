      "content": {
        "h1_flow": { "text": "보고서 작성 · 게시 · 종합 워크플로" },
        "rt_flow_intro": { "markdown": "엔지니어가 작성한 개별 분석 보고서가 팀 주간업무보고에 묶이고, 다시 본부 종합보고로 roll-up 되는 위계적 보고 흐름을 그대로 시스템화한다. 보고서는 항상 개인 공간에서 태어나고, 게시(Mount)를 거쳐 조직 시야에 등장한다." },
        "h2_flow": { "text": "엔지니어 → 임원 까지의 흐름" },
        "fc_flow": { "items": [
          { "label": "엔지니어 — 개인 공간 작성", "description": "초안/메모/시험까지 모두 personal workspace에서" },
          { "label": "조직 게시판에 게시 (Mount)", "description": "여러 게시판 동시 게시 가능, live link (별도 사본 아님)" },
          { "label": "보직장 검토 · 인라인 의견", "description": "ancestor walk 기반 자동 편집권" },
          { "label": "팀 주간업무보고 취합 (Composite recurring)", "description": "게시된 N개 보고서를 item으로 묶음 + 본인 요약" },
          { "label": "본부 종합보고로 roll-up", "description": "Composite of composites — 팀별 주간보고를 다시 item으로" },
          { "label": "임원 — 이전 회차 대비 변동 확인", "description": "지속 진행 보고서 추적" }
        ] },
        "h2_rel": { "text": "보고서 관계 3종 비교" },
        "cmp_rel": { "rows": [
          { "key": "direction", "label": "방향",          "kind": "text", "values": {
              "mount":     "개인 → 조직 게시판",
              "fork":      "다른 팀 게시판 → 내 공간",
              "composite": "조직 게시판 → 종합보고"
          } },
          { "key": "copy",      "label": "사본 여부",      "kind": "text", "values": {
              "mount":     "사본 아님 — live link, 원본 수정 시 즉시 반영",
              "fork":      "스냅샷 — 새 Report, 출처 라벨만 유지",
              "composite": "kind별 분기 — recurring=발행 시 freeze / theme=항상 live"
          } },
          { "key": "edit",      "label": "편집 권한",     "kind": "text", "values": {
              "mount":     "원본 작성자 + 보직장 (mount.edit_policy 별 조정)",
              "fork":      "내 사본은 완전히 내 것 (자유 편집)",
              "composite": "종합보고 자체는 lead, item은 원본 정책 그대로"
          } },
          { "key": "model",     "label": "데이터 모델",   "kind": "text", "values": {
              "mount":     "ReportMount(report_id, workspace_slug, edit_policy, mounted_by, note)",
              "fork":      "Report.forked_from_report_id + forked_at_revision",
              "composite": "CompositeReportItem(composite_id, ref_report_id|ref_composite_id, snapshot_content, snapshot_taken_at)"
          } },
          { "key": "status",    "label": "구현 상태",     "kind": "text", "values": {
              "mount":     "Phase 1 완료",
              "fork":      "Phase 8 예정 (권한 체계 정비 후)",
              "composite": "기존 모델 존재, UI 정비 Phase 5"
          } }
        ] },
        "h2_steps": { "text": "보고서 한 건의 라이프사이클" },
        "bl_steps": { "items": [
          "내 공간에서 [+ 새 보고서] → 템플릿 / 빈 보고서 / AI 생성 중 선택.",
          "위젯을 조합해 본문 작성 (heading · rich_text · table · chart · raci_matrix 등 자유롭게).",
          "보고서를 저장하면 자동으로 개인 공간 폴더에 들어감 (기본: 진행 중).",
          "[게시] 다이얼로그에서 게시할 조직 게시판 선택 + 게시판별 edit_policy 지정.",
          "게시판에서 보직장/동료가 코멘트 또는 직접 편집 (정책에 따라).",
          "팀 주간 종합보고에 item으로 묶임 → 본부 종합보고로 roll-up.",
          "민감 보고서는 [작성자 수정 잠금]을 켜 외부 제출 직전 변동 차단."
        ] }
      },
