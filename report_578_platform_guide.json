          ],
          "backend":     "FastAPI 0.115 + Uvicorn 0.32 + Python 3.12",
          "frontend":    "React 18 + Vite 5 (TipTap 에디터, recharts, plotly)",
          "database":    "PostgreSQL 16 (운영 :5433 / 개발 :5432)",
          "orm":         "SQLAlchemy 2.0 + Alembic (setup_and_upgrade_db.py 1줄 운영)",
          "auth":        "JWT (python-jose) + bcrypt 4.0.1 (passlib 호환 고정)",
          "office":      "python-docx, python-pptx, openpyxl (Word/PPT/Excel 출력)",
          "editor":      "TipTap 기반 본문 + 35종 위젯 (표·차트·관계도·플로우 등)",
          "container":   "apptainer 1.x SIF 단일 이미지 (Ubuntu 24.04 베이스)",
          "api_pattern": "{ success, data, message, errors } envelope (shared/responses.py · shared/api/client.js)"
        },
        "h2_layers": { "text": "3계층 시스템 구조" },
        "tree_layers": {
          "rows": [
            { "label": "ReportArchive" },
            { "label": "개인 작업공간 (personal)", "parent": "ReportArchive", "subtitle": "모든 보고서가 태어나는 곳" },
            { "label": "초안 / 메모 / 시험 작성",   "parent": "개인 작업공간 (personal)" },
            { "label": "폴더 정리 (진행 중 / 종결 / 보관)", "parent": "개인 작업공간 (personal)" },
            { "label": "조직 워크스페이스 (org)",   "parent": "ReportArchive", "subtitle": "팀 · 본부 트리" },
            { "label": "조직 게시판 (Report Mount)", "parent": "조직 워크스페이스 (org)", "subtitle": "개인 보고서를 live link로 노출" },
            { "label": "종합보고 (CompositeReport)", "parent": "조직 워크스페이스 (org)", "subtitle": "정기 / 주제별" },
            { "label": "멤버 · 설정",               "parent": "조직 워크스페이스 (org)" },
            { "label": "공통 메뉴",                 "parent": "ReportArchive", "subtitle": "모든 부서에서 공유" },
